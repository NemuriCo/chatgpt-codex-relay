<Window x:Class="BlueRelay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BlueRelay"
        Width="390"
        Height="650"
        MinWidth="340"
        MinHeight="440"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Background="#15171D"
        Foreground="#F4F5F7"
        Topmost="{Binding IsAlwaysOnTop}"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Border BorderBrush="#303641" BorderThickness="1" CornerRadius="12" Background="#15171D">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="220" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#1B1F26" CornerRadius="8" Padding="10,8" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="BlueRelay" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="ChatGPT ↔ Codex workflow" Foreground="#8D96A5" FontSize="11" Margin="0,2,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Width="32" Height="28" Padding="0" Margin="4,0,0,0" Command="{Binding ToggleAlwaysOnTopCommand}" ToolTip="Toggle always on top">
                        <TextBlock Text="⌖" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                    <Button Grid.Column="2" Width="32" Height="28" Padding="0" Margin="4,0,0,0" Click="HideButton_Click" ToolTip="Hide to tray">
                        <TextBlock Text="—" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                    <Button Grid.Column="3" Width="32" Height="28" Padding="0" Margin="4,0,0,0" Click="HideButton_Click" ToolTip="Hide to tray">
                        <TextBlock Text="×" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                </Grid>
            </Border>

            <Border Grid.Row="1" Margin="0,10,0,0" Padding="8" Background="#2C2920" CornerRadius="6" Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="#F1C75B" FontSize="11" />
            </Border>

            <Grid Grid.Row="2" Margin="0,14,0,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Projects" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Text="Each project keeps its own workflow state." Foreground="#8D96A5" FontSize="11" Margin="0,2,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Content="New project" Command="{Binding NewProjectCommand}" Margin="6,0,0,0" />
            </Grid>

            <Border Grid.Row="3" Background="#1B1F26" CornerRadius="8" Padding="4">
                <Grid>
                    <ListBox ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject, Mode=TwoWay}" IsEnabled="{Binding IsProjectListEnabled}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{Binding StatusBrush}" VerticalAlignment="Top" Margin="0,4,8,0" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding StatusLabel}" Foreground="#AAB2BF" FontSize="11" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding StatusMarker}" Foreground="{Binding StatusBrush}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="No projects yet. Add one to start tracking a workflow." TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#8D96A5" FontSize="12" Visibility="{Binding HasProjects, Converter={StaticResource InverseBoolToVisibility}}" />
                </Grid>
            </Border>

            <Border Grid.Row="4" Margin="0,12,0,0" Background="#1B1F26" CornerRadius="8" Padding="12" Visibility="{Binding HasDetails, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Project details" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="1" Text="Name" Foreground="#8D96A5" FontSize="11" Margin="0,12,0,4" />
                        <TextBox Grid.Row="2" Text="{Binding EditingName, UpdateSourceTrigger=PropertyChanged}" />
                        <Grid Grid.Row="3" Margin="0,10,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Local path" Foreground="#8D96A5" FontSize="11" Margin="0,0,0,4" />
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding EditingLocalPath, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1" Content="Browse" Command="{Binding BrowsePathCommand}" Margin="6,0,0,0" />
                            </Grid>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                                <Button Content="Cancel" Command="{Binding CancelEditCommand}" />
                                <Button Content="Save project" Command="{Binding SaveProjectCommand}" Background="#2C8B75" BorderBrush="#3BAA90" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Grid Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedProject.Name}" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding SelectedProject.StatusLabel}" Foreground="{Binding SelectedProject.StatusBrush}" FontSize="11" Margin="0,3,0,0" />
                            </StackPanel>
                            <TextBlock Text="{Binding SelectedProject.StatusMarker}" Foreground="{Binding SelectedProject.StatusBrush}" FontSize="20" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Grid.Row="1" Text="Local path" Foreground="#8D96A5" FontSize="11" Margin="0,13,0,3" />
                        <TextBlock Grid.Row="2" Text="{Binding SelectedProject.LocalPath}" TextWrapping="Wrap" Foreground="#D7DBE2" FontSize="11" />
                        <Grid Grid.Row="3" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Current task" Foreground="#8D96A5" FontSize="11" />
                            <TextBlock Grid.Column="1" Text="{Binding SelectedProject.CurrentTaskText}" Foreground="#D7DBE2" FontSize="11" Margin="10,0,0,0" />
                        </Grid>
                        <Grid Grid.Row="4" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Edit" Command="{Binding EditProjectCommand}" />
                                <Button Content="Delete" Command="{Binding DeleteProjectCommand}" Background="#3A252A" BorderBrush="#70404B" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <ComboBox Width="165" ItemsSource="{Binding StateOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding ManualState, Mode=TwoWay}" />
                                <Button Content="Apply state" Command="{Binding ApplyStateCommand}" Background="#2C8B75" BorderBrush="#3BAA90" Margin="6,0,0,0" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
