{
  "manifest_version": 3,
  "name": "BlueRelay",
  "version": "0.2.0",
  "description": "Local-only ChatGPT tab bridge for BlueRelay.",
  "default_locale": "en",
  "permissions": ["storage", "tabs"],
  "optional_permissions": ["clipboardRead", "clipboardWrite"],
  "host_permissions": [
    "http://127.0.0.1:48917/*",
    "http://localhost:48917/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_title": "BlueRelay",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": ["shared/utils.js", "content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["shared/*"],
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"]
    }
  ]
}
